        (function () {
          // Runs on the initial load AND on every view-transition swap: Astro
          // re-inserts the `transition:persist`ed sidebar into the new document,
          // and re-inserting a scroll container resets its scrollTop to 0, so we
          // restore the position from sessionStorage before paint to avoid a
          // visible jump. The companion scroll listener below keeps that stored
          // value in lockstep with the live scroll (the hydrated build did this
          // via React); without it the restored value drifts stale and the
          // sidebar jumps to the wrong offset on navigation.
          try {
            var KEY = "fern-sidebar-scroll-position";
            var container = document.getElementById("fern-sidebar-scroll-area");
            if (!container) { return; }
            var storedRaw = window.sessionStorage.getItem(KEY);
            var stored = storedRaw != null ? parseInt(storedRaw, 10) : 0;
            if (Number.isFinite(stored) && stored > 0) {
              container.scrollTop = stored;
              return;
            }
            var active = container.querySelector('.fern-sidebar-link[data-state="active"]');
            if (!active) { return; }
            var cRect = container.getBoundingClientRect();
            var aRect = active.getBoundingClientRect();
            var isAbove = aRect.top < cRect.top;
            var isBelow = aRect.bottom > cRect.bottom;
            if (!isAbove && !isBelow) { return; }
            var offset = aRect.top - cRect.top + container.scrollTop;
            var target = Math.max(0, Math.round(offset - container.clientHeight / 3));
            container.scrollTop = target;
            if (target > 0) {
              window.sessionStorage.setItem(KEY, String(target));
            }
          } catch (e) { /* sessionStorage/layout unavailable — fall back to the hydration-time scroll */ }
        })();
      </script></main><!-- Footer (matches AbstractDefaultDocs footer) --><footer id="fern-footer" class="width-before-scroll-bar"></footer></div><div data-astro-transition-persist="fern-mobile-menu-portal-en-sidebar:|||edfbd0cee5b8f498bc1a973abd60564a59c8bcf361a52cdbd17bebccfe060d51" id="fern-mobile-menu-portal"></div><astro-island uid="1CYrsO" component-url="/docs/_astro/MobileMenuShell._r--WEZ-.js" component-export="default" renderer-url="/docs/_astro/client.C-rCFbtF.js" props="{&quot;navAssetUrl&quot;:[0,&quot;/docs/_fern-files/_nav/42deb31e78c471c9.json&quot;],&quot;sidebarRootNodeId&quot;:[0,&quot;sidebar:|||edfbd0cee5b8f498bc1a973abd60564a59c8bcf361a52cdbd17bebccfe060d51&quot;],&quot;initialNodeId&quot;:[0,&quot;page:docs/youbot&quot;],&quot;visibleNodeIds&quot;:[1,[[0,&quot;root&quot;],[0,&quot;unversioned:root&quot;],[0,&quot;tabbed:|||da7ac76e49733885d2a2e6ef5c381ebc86aeb46302dcee394660670e878149d7&quot;],[0,&quot;tab:docs-1&quot;],[0,&quot;sidebar:|||edfbd0cee5b8f498bc1a973abd60564a59c8bcf361a52cdbd17bebccfe060d51&quot;],[0,&quot;sidebar-group:page:docs/youbot&quot;],[0,&quot;page:docs/youbot&quot;]]],&quot;currentVariantId&quot;:[0,null],&quot;basepath&quot;:[0,&quot;/docs&quot;],&quot;currentLocale&quot;:[0],&quot;hasLight&quot;:[0,true],&quot;hasDark&quot;:[0,true],&quot;productSwitcher&quot;:[0,null],&quot;versionSwitcher&quot;:[0,null],&quot;navbarLinks&quot;:[1,[[0,{&quot;type&quot;:[0,&quot;filled&quot;],&quot;url&quot;:[0,&quot;https://you.com/platform&quot;],&quot;text&quot;:[0,&quot;API Platform&quot;],&quot;icon&quot;:[0],&quot;rightIcon&quot;:[0,&quot;&lt;svg xmlns=\&quot;http://www.w3.org/2000/svg\&quot; width=\&quot;16\&quot; height=\&quot;16\&quot; viewBox=\&quot;0 0 16 16\&quot; fill=\&quot;none\&quot;&gt;&lt;path d=\&quot;M4.66675 4.6665H11.3334M11.3334 4.6665V11.3332M11.3334 4.6665L4.66675 11.3332\&quot; stroke=\&quot;currentColor\&quot; stroke-width=\&quot;1.2\&quot; stroke-linecap=\&quot;round\&quot; stroke-linejoin=\&quot;round\&quot;